# Notion
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxx

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Blotato
BLOTATO_API_KEY=your_blotato_api_key
BLOTATO_LINKEDIN_ACCOUNT_ID=your_linkedin_account_id_from_blotato

# Your Render service URL (used in review links sent to Slack)
BASE_URL=https://linkedin-post-automation.onrender.com

# Optional: Slack Incoming Webhook URL for review notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Optional: paste your brand guidelines / voice/tone here
BRAND_KNOWLEDGE=

# Schedule (UTC)
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=30

# SQLite path (Render sets this automatically via render.yaml)
DB_PATH=reviews.db
